{%- comment -%}
  TRMNL full layout (800x480).

  Op het TRMNL-platform wordt de markup automatisch in de juiste `view`-div
  gewikkeld, dus we leveren zelf alleen `layout` + `title_bar` -- die twee
  moeten broers zijn, niet genest.

  Compositie: een kopstrook met titel, metaregel en een compacte foto, en
  daaronder twee kolommen -- ingrediënten links, bereidingswijze rechts. De foto
  is met opzet klein (180x104): hij is er om het gerecht te herkennen, de
  hoogte is nodig voor de tekst waar je uit kookt.
{%- endcomment -%}

{%- comment -%} Metaregel: "4 personen · 20 min · 560 kcal", zonder losse scheidingstekens als een veld ontbreekt. {%- endcomment -%}
{%- assign meta = "" -%}
{%- if servings -%}{%- assign meta = meta | append: servings -%}{%- endif -%}
{%- if prep_time -%}
  {%- if meta != "" -%}{%- assign meta = meta | append: " · " -%}{%- endif -%}
  {%- assign meta = meta | append: prep_time -%}
{%- endif -%}
{%- if kcal -%}
  {%- if meta != "" -%}{%- assign meta = meta | append: " · " -%}{%- endif -%}
  {%- assign meta = meta | append: kcal -%}
{%- endif -%}

{%- assign ingredient_count = ingredients | size -%}
{%- assign step_count = steps | size -%}

<div class="layout">
  <div class="flex flex--row gap">
    <div class="flex flex--col grow">
      <span class="title title--small">Recept van vandaag</span>
      <span class="value value--large" data-clamp="2">{{ title }}</span>
      {%- if meta != "" %}
      <span class="label">{{ meta }}</span>
      {%- endif %}
    </div>
    {%- if image %}
    <img class="image image-dither image--cover w--[180px] h--[104px] shrink-0" src="{{ image }}" alt="">
    {%- endif %}
  </div>

  {%- if ingredient_count > 0 or step_count > 0 %}
  <div class="flex flex--row gap grow">
    {%- if ingredient_count > 0 %}
    <div class="flex flex--col w--[34cqw] shrink-0">
      <span class="title title--small">Ingrediënten</span>
      {%- for ingredient in ingredients %}
      <span class="description">{{ ingredient }}</span>
      {%- endfor %}
    </div>
    {%- endif %}

    {%- if step_count > 0 %}
    <div class="flex flex--col grow">
      <span class="title title--small">Bereiding</span>
      {%- for step in steps %}
      <div class="item">
        <div class="meta"><span class="index">{{ forloop.index }}</span></div>
        <div class="content">
          <span class="description">{{ step }}</span>
        </div>
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
  {%- endif %}
</div>

<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg" alt="">
  <span class="title">Allerhande</span>
  <span class="instance">{{ date | date: "%d-%m-%Y" }}</span>
</div>
