{%- comment -%}
  TRMNL half_vertical layout (400x480).

  Smal maar hoog: alles onder elkaar. De afbeelding blijft, en er is ruimte
  voor een korte ingrediëntenlijst in één kolom.
{%- endcomment -%}

{%- assign meta = "" -%}
{%- if servings -%}{%- assign meta = meta | append: servings -%}{%- endif -%}
{%- if prep_time -%}
  {%- if meta != "" -%}{%- assign meta = meta | append: " · " -%}{%- endif -%}
  {%- assign meta = meta | append: prep_time -%}
{%- endif -%}
{%- if kcal -%}
  {%- if meta != "" -%}{%- assign meta = meta | append: " · " -%}{%- endif -%}
  {%- assign meta = meta | append: kcal -%}
{%- endif -%}

{%- assign count = ingredients | size -%}

<div class="layout">
  <span class="title title--small">Recept van vandaag</span>
  <span class="value value--large" data-clamp="3">{{ title }}</span>
  {%- if meta != "" %}
  <span class="label">{{ meta }}</span>
  {%- endif %}

  {%- if image %}
  <img class="image image-dither image--cover" src="{{ image }}" alt="">
  {%- endif %}

  {%- if count > 0 %}
  <span class="title title--small">Ingrediënten</span>
  {%- for ingredient in ingredients limit: 6 %}
  <span class="description">{{ ingredient }}</span>
  {%- endfor %}
  {%- endif %}
</div>

<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg" alt="">
  <span class="title">Allerhande</span>
  <span class="instance">{{ date | date: "%d-%m-%Y" }}</span>
</div>
